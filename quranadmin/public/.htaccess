# Static site settings for cPanel (Apache)
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

# Force https: turn on ONLY after the subdomain has an SSL certificate (remove the # from the 4 lines below)
# RewriteEngine On
# RewriteCond %{HTTPS} off
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Cache build files for a long time (their names change on every build); always re-check HTML
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|ttf|png|svg|jpg|webp|mp3)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html|txt|json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
