# Copy this file to .env and fill it in (or set the same names in cPanel → Setup Node.js App → Environment variables)
ADMIN_EMAIL=admin@toptol.site
ADMIN_PASSWORD=ChangeMe@123
# long random text; keep it secret
JWT_SECRET=
# list both http and https so it keeps working after SSL is added
ALLOWED_ORIGINS=http://nurquran.toptol.site,https://nurquran.toptol.site,http://quranadmin.toptol.site,https://quranadmin.toptol.site
# use https:// here once the subdomain has SSL
PUBLIC_URL=http://apiquran.toptol.site
